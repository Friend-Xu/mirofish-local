# MiroFish Local — 配置模板
# 复制为 .env 后填写；.env 已被 .gitignore 排除，不要提交。
# 完整部署与排错见 docs/DEPLOYMENT.md。

# ===== LLM（必填）=====
# 支持 OpenAI SDK 格式的任意 API；先用小规模模拟验证，避免消耗过大。
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 图谱后端 =====
# 本地分支默认使用 Graphiti + 嵌入式 Kuzu；不需要 ZEP_API_KEY。
ZEP_BACKEND=graphiti

# 可选：使用 Zep Cloud（与上游一致）时改为：
# ZEP_BACKEND=cloud
# ZEP_API_KEY=your_zep_api_key_here

# ===== 本地 Graphiti（ZEP_BACKEND=graphiti）=====
# 图库是单文件；停后端后再做备份/离线检查（Kuzu 单进程文件锁）。
# GRAPHITI_DB_PATH=backend/uploads/graphs/graphiti.kuzu
# 模型文件不入库，先运行 scripts/provision-models.py --fetch/--verify。
# GRAPHITI_EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
# GRAPHITI_EMBEDDING_DIM=512
# GRAPHITI_RERANKER=rrf
# 留空（不设置）即使用上游默认 0.6；显式设置必须在 (0, 1] 内，禁止 0。
# GRAPHITI_MIN_SCORE=0.6
# GRAPHITI_BULK_SLICE=5
# GRAPH_MEMORY_BATCH_SIZE=20
# GRAPHITI_EXTRACTION_INSTRUCTIONS=

# ===== 无 NVIDIA GPU 时的显式放行（启动器读取）=====
# 推荐时间线会退回 CPU，可能很慢；不要把它当成默认行为。
# MIROFISH_ALLOW_CPU_RECSYS=1

# ===== LLM 加速（可选）=====
# 不使用就不要保留下面三行（.env.example 要求：不用时不要出现这些键）。
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
